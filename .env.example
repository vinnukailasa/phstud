# Copy to .env and update values
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
NEXT_PUBLIC_APP_NAME="Photo Studio Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Super Admin (created on first seed)
SUPER_ADMIN_EMAIL="admin@phstud.local"
SUPER_ADMIN_PASSWORD="Admin@123"

# One-time browser setup: visit /api/setup?secret=YOUR_VALUE then remove this var
SETUP_SECRET="generate-a-random-string-and-delete-after-setup"
